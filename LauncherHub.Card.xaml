<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="CardRoot" Height="202" Margin="9,8" CornerRadius="10" Background="#17232D" BorderBrush="#304450" BorderThickness="1" AllowDrop="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="52"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="16,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
      <Border Background="#0D1923" CornerRadius="10" Width="58" Height="58">
        <Grid><Image x:Name="LauncherIcon" Width="46" Height="46" Stretch="Uniform"/><TextBlock x:Name="IconFallback" Text="L" Foreground="#8CD9FF" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,12,0">
        <TextBlock x:Name="LauncherName" FontSize="17" FontWeight="SemiBold" Foreground="#F1F6FA" TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
          <Ellipse x:Name="RunningDot" Fill="#8195A5" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="RunningState" Text="Geschlossen" FontSize="12" Foreground="#9DB3C3"/>
        </StackPanel>
      </StackPanel>
      <Button x:Name="MenuButton" Grid.Column="2" Content="⋯" Width="32" Height="32" FontSize="19" VerticalAlignment="Top" ToolTip="Launcher verwalten" AutomationProperties.Name="Launcher verwalten"/>
    </Grid>
    <Border Grid.Row="1" Background="#131F28" BorderBrush="#293C49" BorderThickness="0,1,0,1">
      <Grid Margin="16,7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="126"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
        <Border x:Name="StatusBadge" Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="#8FA5B5" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="UpdateStatus" Grid.Column="1" Text="Versionsprüfung läuft" FontSize="11.5" Foreground="#A8BECD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>
        <Button x:Name="UpdateButton" Grid.Column="1" Content="Aktualisieren" Height="32" Margin="0,0,8,0" IsEnabled="False" FontSize="11.5"/>
        <Button x:Name="OpenButton" Grid.Column="2" Content="Öffnen" Height="32" FontSize="12"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="16,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Der Hub erhält aktuell keinen bestätigten Anmeldestatus. Ein laufender Prozess oder gespeicherte Konten sind kein Nachweis.">
        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#9FB9CC" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
        <TextBlock Text="Konto: nicht prüfbar" FontSize="10.5" Foreground="#94ACBD"/>
      </StackPanel>
      <CheckBox x:Name="AutoStart" Grid.Column="1" Content="Autostart" FontSize="10.5" VerticalAlignment="Center" ToolTip="Mit Windows starten (über Launcher Hub)" AutomationProperties.Name="Mit Windows starten"/>
    </Grid>
    <TextBlock x:Name="Operation" Grid.Row="3" Margin="16,0,16,4" FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="#A5BCCD" VerticalAlignment="Center"/>
  </Grid>
</Border>
